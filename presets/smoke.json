{
  "architecture": "linear",
  "z_dim": 2,
  "dropout": 0.0,
  "optimizer": "adam",
  "lr_pretrain": 0.005,
  "lr_joint": 0.001,
  "batch_size": 32,
  "pretrain_epochs": 2,
  "outer_iterations": 2,
  "joint_epochs_per_outer": 1,
  "partition_initialization": "latent_kmeans",
  "partition_sampler": "single_chain_sequential",
  "gibbs_sweeps_per_outer": 2,
  "mc_partitions": 2,
  "initial_chain_burnin_sweeps": 0,
  "lambda_calibration_stage": "after_warmup",
  "target_gradient_ratio": 1.0,
  "latent_scale_projection": false,
  "eta_initialization": "pretrained_loss",
  "eta_a": 1.0,
  "eta_b": 1.0,
  "eta_shape_scale": 1.0,
  "eta_multiplier": 1.0,
  "encoder_prior_precision": 0.0001,
  "decoder_prior_precision": 0.0001,
  "posterior_burnin_sweeps": 2,
  "posterior_samples": 6,
  "posterior_thinning": 1,
  "posterior_summary": "vi_medoid",
  "psm_mode": "auto",
  "standardize": "none",
  "device": "cpu",
  "num_workers": 0
}
