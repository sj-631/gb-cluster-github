{
  "architecture": "linear",
  "z_dim": 6,
  "dropout": 0.0,
  "optimizer": "adam",
  "lr_pretrain": 0.005,
  "lr_joint": 0.001,
  "batch_size": 64,
  "pretrain_epochs": 100,
  "outer_iterations": 100,
  "joint_epochs_per_outer": 1,
  "partition_initialization": "provided",
  "partition_sampler": "single_chain_sequential",
  "gibbs_sweeps_per_outer": 10,
  "mc_partitions": 5,
  "initial_chain_burnin_sweeps": 0,
  "lambda_calibration_stage": "before_warmup",
  "target_gradient_ratio": 1.0,
  "gradient_epsilon": 1e-12,
  "calibration_batches": null,
  "latent_scale_projection": true,
  "eta_initialization": "pretrained_loss",
  "eta_a": 1.0,
  "eta_b": 1.0,
  "eta_shape_scale": 1.0,
  "eta_multiplier": 1.0,
  "encoder_prior_precision": 0.0001,
  "decoder_prior_precision": 0.0001,
  "posterior_burnin_sweeps": 100,
  "posterior_samples": 500,
  "posterior_thinning": 1,
  "posterior_summary": "salso",
  "salso_n_runs": 64,
  "salso_n_cores": 1,
  "psm_mode": "auto",
  "psm_max_n": 2500,
  "standardize": "none",
  "device": "cpu",
  "num_workers": 0
}
